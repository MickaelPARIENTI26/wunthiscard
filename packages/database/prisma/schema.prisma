// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USERS
// ==========================================

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  passwordHash        String? // null if OAuth only
  firstName           String
  lastName            String
  displayName         String?
  dateOfBirth         DateTime?
  phone               String?
  instagram           String?
  avatarUrl           String?
  emailMarketing      Boolean   @default(false) // PECR opt-in: promotional / new-competition emails. Transactional emails (order, results, wins) are always sent.
  role                UserRole  @default(USER)
  isActive            Boolean   @default(true)
  isBanned            Boolean   @default(false)
  banReason           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0) // Bumped on password reset/change to invalidate all existing JWT sessions
  unsubscribeToken    String?   @unique // Stable per-user token for one-click marketing-email unsubscribe (no login required)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Referral system
  referralCode                String?  @unique // Auto-generated 8-char code (e.g. "MICK3A2F")
  referredById                String?          // The user who referred this user
  referralTicketCount         Int      @default(0) // [legacy] old per-10 progress counter — unused under the one-time rule
  referralTotalTickets        Int      @default(0) // [legacy] lifetime tickets from referees — no longer written
  referralFreeTicketsEarned   Int      @default(0) // Total free tickets earned via referrals (1 per referee's first purchase)
  referralFreeTicketsAvailable Int     @default(0) // Free tickets not yet used
  referralRewardGranted       Boolean  @default(false) // True once THIS user (as a referee) has rewarded their referrer with the one-time +1

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  tickets            Ticket[]
  wins               Win[]
  auditLogs          AuditLog[]
  wheelSpins         WheelSpin[]
  promoCodes         PromoCode[]
  jackpotWins        JackpotWin[]
  drawnCompetitions  Competition[] @relation("DrawnCompetitions")
  drawLogs           DrawLog[]     @relation("DrawnByUser")
  referredBy         User?         @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]        @relation("Referrals") // Users this user has referred

  @@index([email])
  @@index([role])
  @@index([referralCode])
  @@index([referredById])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DRAW_MASTER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // "oauth" | "credentials"
  provider          String // "google" | "credentials"
  providerAccountId String
  access_token      String?
  refresh_token     String?
  token_type        String?
  scope             String?
  id_token          String?
  expires_at        Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime
  type       TokenType @default(EMAIL_VERIFICATION)

  @@unique([identifier, token])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_UNLOCK
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String? // "Home", "Office", etc.
  line1     String
  line2     String?
  city      String
  county    String?
  postcode  String
  country   String  @default("GB")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// COMPETITIONS
// ==========================================

model Competition {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  subtitle         String?
  descriptionShort String
  descriptionLong  String // Rich HTML content
  category         CompetitionCategory
  subcategory      String?
  status           CompetitionStatus   @default(DRAFT)
  isFeatured       Boolean             @default(false) // Only one competition can be featured on homepage

  // Competition type
  isFree   Boolean @default(false) // Free competition (no payment required)
  drawType String  @default("single") // "single" or "multi"
  prizes   Json?   // Multi-draw: [{ position, title, value, imageUrl, certification, grade }]

  // Mystery card
  isMystery          Boolean  @default(false)
  isRevealed         Boolean  @default(false) // Admin reveals after draw
  minimumValue       Decimal? @db.Decimal(10, 2) // Minimum guaranteed value shown to public
  teaser             String?  // Teaser description ("A fan-favourite from Gen 1...")
  realTitle          String?  // Hidden until reveal
  realValue          Decimal? @db.Decimal(10, 2) // Hidden until reveal
  realImages         String[] // Hidden until reveal
  realCertification  String?  // Hidden until reveal
  realGrade          String?  // Hidden until reveal

  // Prize details
  prizeValue        Decimal  @db.Decimal(10, 2) // £ total value (sum of all prizes for multi-draw)
  ticketPrice       Decimal  @db.Decimal(10, 2)
  totalTickets      Int? // null = unlimited participants (free competitions only)
  maxTicketsPerUser Int      @default(0) // 0 = no per-user ticket limit

  // Dates
  saleStartDate  DateTime? // When tickets go on sale
  drawDate       DateTime // Latest date for the draw
  actualDrawDate DateTime? // When the draw actually happened

  // Media
  mainImageUrl String
  galleryUrls  String[] // Array of image URLs
  videoUrl     String?

  // Authentication / Grading
  certificationNumber String?
  grade               String?
  condition           String?
  provenance          String?

  // Skill Question (QCM)
  questionText    String
  questionChoices Json // ["Choice A", "Choice B", "Choice C", "Choice D"]
  questionAnswer  Int // Index of correct answer (0-3)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Draw result
  winningTicketNumber Int?
  drawProofUrl        String? // Link to video/proof
  drawnById           String? // Admin who executed the draw
  winnerNotified      Boolean @default(false) // Email sent to winner

  // Lifecycle email idempotency guards (set once when the blast is sent, so it never repeats)
  newCompEmailSentAt     DateTime? // "New competition live" marketing blast sent (on ACTIVE)
  closingSoonEmailSentAt DateTime? // "Closing soon" marketing blast sent (cron, before draw)
  resultsEmailSentAt     DateTime? // "Draw complete" results email sent to participants

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets     Ticket[]
  orders      Order[]
  wins        Win[]
  drawLogs    DrawLog[]
  wheelConfig WheelConfig?
  wheelSpins  WheelSpin[]
  jackpotWins JackpotWin[]
  promoCodes  PromoCode[]
  drawnBy   User?     @relation("DrawnCompetitions", fields: [drawnById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([drawDate])
  @@index([isFeatured])
}

enum CompetitionCategory {
  POKEMON
  ONE_PIECE
  SPORTS_BASKETBALL
  SPORTS_FOOTBALL
  SPORTS_OTHER
  MEMORABILIA
  YUGIOH
  MTG
  OTHER
}

enum CompetitionStatus {
  DRAFT
  UPCOMING
  ACTIVE
  SOLD_OUT
  DRAWING
  COMPLETED
  CANCELLED
}

// ==========================================
// TICKETS & ORDERS
// ==========================================

model Ticket {
  id            String       @id @default(cuid())
  competitionId String
  ticketNumber  Int // 1 to totalTickets
  userId        String? // null = available
  orderId       String?
  isBonus       Boolean      @default(false) // Free bonus ticket
  isFreeEntry   Boolean      @default(false) // Free postal entry
  status        TicketStatus @default(AVAILABLE)
  reservedUntil DateTime? // Temporary reservation during checkout

  competition Competition @relation(fields: [competitionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?      @relation(fields: [orderId], references: [id])
  wheelSpin   WheelSpin?

  @@unique([competitionId, ticketNumber])
  @@index([competitionId, status])
  @@index([userId])
  @@index([orderId])
}

enum TicketStatus {
  AVAILABLE
  RESERVED // Temporarily held during checkout (5 min TTL)
  SOLD
  FREE_ENTRY // Postal free entry
}

model Order {
  id               String  @id @default(cuid())
  orderNumber      String  @unique // Human-readable: WTC-20260209-XXXX
  userId           String? // Optional to allow anonymization on account deletion
  competitionId    String
  ticketCount      Int // Paid tickets
  bonusTicketCount Int     @default(0)
  totalAmount      Decimal @db.Decimal(10, 2) // £
  currency         String  @default("GBP")

  // Stripe
  stripePaymentIntentId String?       @unique
  stripeSessionId       String?
  paymentStatus         PaymentStatus @default(PENDING)

  // QCM
  questionAnswered Boolean @default(false)
  questionCorrect  Boolean @default(false)

  // True if this order was the referee's qualifying first purchase that granted the
  // referrer a free ticket. Lets a full refund / lost dispute claw that reward back.
  grantedReferralReward Boolean @default(false)

  // Set once an abandoned-cart recovery email has been sent for this order, so the
  // daily cron never nudges the same abandoned checkout twice.
  recoveryEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  competition Competition @relation(fields: [competitionId], references: [id])
  tickets     Ticket[]
  wheelSpins  WheelSpin[]
  jackpotWins JackpotWin[]
  promoCodesRedeemed PromoCode[] @relation("PromoCodeRedeemedOrder")

  @@index([userId])
  @@index([competitionId])
  @@index([paymentStatus])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

// ==========================================
// WINS & RESULTS
// ==========================================

model Win {
  id              String    @id @default(cuid())
  competitionId   String
  userId          String?   // Optional to allow anonymization on account deletion
  ticketNumber    Int
  prizePosition   Int       @default(1) // 1 = 1st prize, 2 = 2nd, etc. (always 1 for single draw)
  prizeTitle      String?   // For multi-draw: "Charizard PSA 10" etc.
  prizeValue      Decimal?  @db.Decimal(10, 2) // Individual prize value (multi-draw)
  claimedAt       DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNumber  String?
  trackingUrl     String?
  shippingCarrier String?
  notes           String?

  competition Competition @relation(fields: [competitionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, prizePosition])
  @@index([competitionId])
  @@index([userId])
}

// ==========================================
// CMS & SETTINGS
// ==========================================

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique // "about-us", "faq", "how-it-works"
  title     String
  content   String // Rich HTML
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String  @id @default(cuid())
  category  String // "Account", "Tickets", "Payment", etc.
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([category])
  @@index([sortOrder])
}

model SiteSettings {
  id   String @id @default("global")
  data Json // All settings as JSON
  // Contains: company info, social links, bonus tiers,
  // default QCM, email config, etc.
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ==========================================
// EMAIL TEMPLATES
// ==========================================

model EmailTemplate {
  id                 String       @id @default(cuid())
  slug               String       @unique // ex: "email_verification"
  name               String // ex: "Email Verification"
  subject            String // Subject line with {{variables}}
  htmlContent        String       @db.Text // HTML content
  isActive           Boolean      @default(true)
  trigger            EmailTrigger @default(AUTO)
  triggerDescription String? // Human-readable description

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([trigger])
  @@index([isActive])
}

enum EmailTrigger {
  AUTO // Sent automatically on event
  MANUAL // Sent manually by admin
  CRON // Sent by scheduled job
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // "TICKET_PURCHASED", "DRAW_EXECUTED", "USER_BANNED", etc.
  entity    String // "competition", "ticket", "user", etc.
  entityId  String?
  metadata  Json? // Additional context
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// DRAW AUDIT LOG
// ==========================================

model DrawLog {
  id                   String    @id @default(cuid())
  competitionId        String
  competitionTitle     String
  totalTickets         Int
  ticketsSold          Int
  winningTicketNumber  Int
  winnerUserId         String?
  winnerName           String
  winnerEmail          String
  drawnById            String
  drawnByRole          String // "DRAW_MASTER" or "SUPER_ADMIN"
  drawMethod           String    @default("crypto.randomInt")
  ipAddress            String?
  userAgent            String?
  emailSentAt          DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())

  competition Competition @relation(fields: [competitionId], references: [id])
  drawnBy     User        @relation("DrawnByUser", fields: [drawnById], references: [id])

  @@index([competitionId])
  @@index([drawnById])
  @@index([createdAt])
}

// Pre-launch waiting list: email-only signups from the coming-soon gate.
// notifiedAt is stamped when the one-time launch announcement is sent.
model WaitlistSubscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@map("waitlist_subscribers")
}

// ==========================================
// WHEEL — post-purchase reward wheel
// See tasks/wheel-plan.md for the design decisions behind this.
// ==========================================

enum WheelSlotType {
  NO_WIN
  PERCENT_OFF
  JACKPOT
}

enum JackpotStatus {
  PENDING
  CONTACTED
  ADDRESS_CONFIRMED
  SHIPPED
  DELIVERED
}

/// Per-competition wheel settings. One row per competition, created by the admin.
model WheelConfig {
  id            String  @id @default(cuid())
  competitionId String  @unique
  enabled       Boolean @default(false)

  jackpotEnabled     Boolean  @default(true)
  jackpotDescription String?
  jackpotValue       Decimal? @db.Decimal(10, 2)

  /// How long a promo code stays valid once won.
  couponValidityDays Int @default(30)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  slots       WheelSlot[]
  spins       WheelSpin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One reward kind and its finite stock — the wheel draws WITHOUT replacement,
/// so a slot with quantityConfigured = 1 can be won exactly once.
model WheelSlot {
  id            String        @id @default(cuid())
  wheelConfigId String
  type          WheelSlotType
  /// Percentage for PERCENT_OFF; 0 for NO_WIN and JACKPOT so the unique index
  /// below actually constrains (Postgres treats NULLs as distinct).
  value              Int @default(0)
  quantityConfigured Int
  quantityWon        Int @default(0)

  wheelConfig WheelConfig @relation(fields: [wheelConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wheelConfigId, type, value])
  @@index([wheelConfigId])
}

/// A spin owed to a buyer: one per PAID ticket (bonus, referral and free-entry
/// tickets grant none). Banked until spunAt is set, and dead after expiresAt.
model WheelSpin {
  id            String @id @default(cuid())
  wheelConfigId String
  competitionId String
  userId        String?
  orderId       String?
  /// One spin per ticket, enforced by the database rather than by application
  /// code — a re-run of fulfilment can never mint a second spin for a ticket.
  ticketId String? @unique

  grantedAt DateTime  @default(now())
  /// Competition draw date: an unspun wheel dies with its competition.
  expiresAt DateTime
  spunAt    DateTime?

  /// Result, set at spin time. Null while unspun.
  resultType  WheelSlotType?
  resultValue Int?

  wheelConfig WheelConfig @relation(fields: [wheelConfigId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?      @relation(fields: [orderId], references: [id])
  ticket      Ticket?     @relation(fields: [ticketId], references: [id])
  promoCode   PromoCode?
  jackpotWin  JackpotWin?

  @@index([competitionId])
  @@index([userId, spunAt])
  @@index([orderId])
}

/// A discount won on the wheel. Owned by one user, single use, never transferable.
model PromoCode {
  id     String  @id @default(cuid())
  code   String  @unique
  userId String?
  spinId String  @unique

  /// Kept for reporting once the spin is anonymised.
  competitionId String?
  percentOff    Int

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  redeemedAt      DateTime?
  redeemedOrderId String?

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  spin          WheelSpin    @relation(fields: [spinId], references: [id], onDelete: Cascade)
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  redeemedOrder Order?       @relation("PromoCodeRedeemedOrder", fields: [redeemedOrderId], references: [id], onDelete: SetNull)

  @@index([userId, redeemedAt])
  @@index([competitionId])
}

/// The graded-card win. Mirrors Win's fulfilment lifecycle so the admin flow
/// feels the same, but is kept separate: this is not a competition prize.
model JackpotWin {
  id            String  @id @default(cuid())
  spinId        String  @unique
  competitionId String
  userId        String?
  orderId       String?

  status JackpotStatus @default(PENDING)

  prizeDescription String
  prizeValue       Decimal? @db.Decimal(10, 2)

  adminNotes     String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  spin        WheelSpin   @relation(fields: [spinId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?      @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([competitionId])
}
